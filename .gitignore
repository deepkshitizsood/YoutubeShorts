.DS_Store

# Audio assets must be committed - the GitHub Actions runner builds videos from a
# fresh clone, so anything not in the repo simply does not exist there.
!assets/music/**/*.mp3
!assets/music/**/*.wav
!assets/sfx/**/*.mp3
!assets/sfx/**/*.wav
