# Copy to .env for local runs (python-dotenv loads it automatically).
# In GitHub Actions these are set as repo secrets instead - see README.md.

ANTHROPIC_API_KEY=
GOOGLE_TTS_API_KEY=
GOOGLE_IMAGE_API_KEY=
# Optional but recommended: free key from https://www.pexels.com/api/
# Enables real stock footage instead of only AI stills. Unset = AI images only.
PEXELS_API_KEY=
# Optional: only used if providers.hero_video_clip.enabled is turned back on.
RUNWAY_API_KEY=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
